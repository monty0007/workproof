# ─── WorkProof Backend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# cp backend/.env.example backend/.env

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (workproof.db created automatically — good for local dev).
# Set to a PostgreSQL connection string for production.
DATABASE_URL=

# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/workproof?sslmode=require

# ── Midnight Service ───────────────────────────────────────────────────────────
# URL of the running midnight-service Node.js bridge (default: localhost:6300).
# Only change this if you're running midnight-service on a different host/port.
ZK_SERVICE_URL=http://localhost:6300
