# ─── WorkProof Midnight Service Environment Variables ─────────────────────────
# Copy this file to midnight-service/.env and fill in your values.
# cp midnight-service/.env.example midnight-service/.env
# (Most values have sensible defaults for local development — no changes needed.)

# ── Network ────────────────────────────────────────────────────────────────────
# Which Midnight network to connect to.
# Options: local | preprod
MIDNIGHT_ENV=preprod

# ── Port ───────────────────────────────────────────────────────────────────────
# Port this service listens on. Backend expects it at 6300.
PORT=6300
